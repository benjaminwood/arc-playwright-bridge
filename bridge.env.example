# Copy to bridge.env (not in git) and adjust. Sourced by bin/browser-bridge
# and install.sh.

# Node 20+ for Playwright MCP (default: `node` on PATH).
#BRIDGE_NODE=/opt/homebrew/bin/node

# The patched extension's folder as loaded unpacked in Arc (default: this
# repo's extension/). Readiness checks compare against it.
#BRIDGE_EXTENSION_DIR=~/arc-playwright-bridge/extension

# Where the last readable extension token per profile is cached (mode 600).
#BRIDGE_TOKEN_CACHE=~/.config/arc-playwright-bridge/tokens

# Origins never driven or opened through the bridge, ";"-separated: e.g. the
# page where you approve the agent's actions. The Tailscale admin console is
# always hidden. install.sh also writes these into the extension.
#BRIDGE_HIDDEN_ORIGINS="https://approvals.example.ts.net"
